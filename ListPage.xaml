<Page x:Class="pr6.ListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr6"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListPage"
      Style="{StaticResource page}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource zag}" Text="Библиотека"/>
            
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock  Text="Категория" Style="{StaticResource mini}"/>
           
            <ComboBox Width="250" Style="{StaticResource cmbBox}">
                <ComboBoxItem Content="Детектив"/>
                <ComboBoxItem Content="Фэнтези"/>
                <ComboBoxItem Content="Роман"/>
            </ComboBox>

            <TextBlock  Text="Название" Style="{StaticResource mini}"/>
            
            <TextBox Width="250" Style="{StaticResource txtBox}"/>
            <CheckBox Content="Аудиокнига" Style="{StaticResource chkB}"/>
            <CheckBox Content="Книга" Style="{StaticResource chkB}"/>
            <RadioButton Content="Бесплатно" Style="{StaticResource rdBtn}"/>
            <Button  Width="150" Style="{StaticResource def}"  IsEnabled="False">
                Поиск
            </Button>
        </StackPanel>
        
        <StackPanel Grid.Row="1" Grid.Column="1">
            <Border Width="300" Height="300" BorderBrush="{StaticResource gray}" BorderThickness="10" Margin="5">
                <TextBlock Text="Найденные книги" Style="{StaticResource mini}" >
                    <Border CornerRadius="5"/>
                </TextBlock>
            </Border>
        </StackPanel>
        
        <Button Grid.Row="2" Grid.Column="1" Width="100" Style="{StaticResource danger}" IsEnabled="False">
            Выйти
        </Button>
        <Button Grid.Row="2"  Style="{StaticResource sec}" Click="Button_Click">
            Сменить режим 
        </Button>
        <ProgressBar Grid.Row="2" Grid.Column="2" />
        <StackPanel Grid.Row="1" Grid.Column="2">
            <TextBlock Text="Оставить отзыв" Style="{StaticResource mini}"/>
            <TextBox Style="{StaticResource multyLine}"  Height="70" Width="200" />
            <Button Style="{StaticResource def}" Width="200"  IsEnabled="False">Отправить</Button>
        </StackPanel>
    </Grid>
</Page>
